<odoo>
    <template
        id="homepage"
        inherit_id="website.homepage"
        name="PMS travel homepage"
    >
        <xpath expr="//div[@id='wrap']" position="replace">
            <main id="wrap" class="oe_structure amu-homepage">
                <section class="amu-hero">
                    <div class="amu-hero-grid">
                        <div class="amu-hero-copy">
                            <p class="amu-eyebrow">
                                ALOJAMIENTOS CON CARÁCTER
                            </p>
                            <h1>Un lugar nuevo. Una forma distinta de viajar.</h1>
                            <p class="amu-intro">
                                Encontrá espacios especiales para descubrir cada
                                destino a tu manera.
                            </p>
                        </div>
                        <div class="amu-hero-visual">
                            <img
                                class="amu-hero-image"
                                src="/pms_website/static/img/demo_property_suburban.jpg"
                                alt="Casa de vacaciones con piscina"
                                fetchpriority="high"
                            />
                            <div class="amu-image-caption">
                                <span>Tu próxima historia empieza acá</span>
                                <span class="amu-caption-mark" aria-hidden="true">✳</span>
                            </div>
                            <img
                                class="amu-inset-image"
                                src="/pms_website/static/img/demo_property_downtown.jpg"
                                alt="Interior luminoso de un alojamiento"
                                loading="lazy"
                            />
                        </div>
                    </div>

                    <form
                        class="amu-search"
                        action="/property"
                        method="get"
                        role="search"
                    >
                        <div class="amu-search-field amu-search-destination">
                            <label for="amu-search-destination">Destino</label>
                            <input
                                id="amu-search-destination"
                                type="search"
                                name="search"
                                placeholder="¿A dónde querés ir?"
                            />
                        </div>
                        <div class="amu-search-field amu-search-dates">
                            <label for="amu-search-dates">Fechas</label>
                            <div class="amu-date-range">
                                <input
                                    id="amu-search-dates"
                                    type="date"
                                    name="date_start"
                                    aria-label="Fecha de entrada"
                                />
                                <span class="amu-date-range-separator" aria-hidden="true">—</span>
                                <input
                                    type="date"
                                    name="date_end"
                                    aria-label="Fecha de salida"
                                />
                            </div>
                        </div>
                        <div class="amu-search-field amu-search-guests">
                            <label>Huéspedes</label>
                            <button
                                id="amu-search-guests"
                                class="amu-occupancy-trigger"
                                type="button"
                                aria-haspopup="dialog"
                                aria-expanded="false"
                                aria-controls="amu-home-occupancy"
                                data-occupancy-trigger=""
                            >
                                <span data-occupancy-summary="">2 adultos · 0 niños · 1 habitación</span>
                                <i class="fa fa-angle-down" aria-hidden="true"/>
                            </button>
                            <input type="hidden" name="adults" value="2" data-occupancy-value="adults"/>
                            <input type="hidden" name="children" value="0" data-occupancy-value="children"/>
                            <input type="hidden" name="rooms" value="1" data-occupancy-value="rooms"/>
                            <input type="hidden" name="guest_select" value="2" data-occupancy-total=""/>
                            <input type="hidden" name="work" value="0" data-occupancy-toggle-value="work"/>
                            <input type="hidden" name="pets" value="0" data-occupancy-toggle-value="pets"/>
                            <div
                                id="amu-home-occupancy"
                                class="amu-occupancy-popover"
                                role="dialog"
                                aria-label="Huéspedes y habitaciones"
                                hidden="hidden"
                            >
                                <div class="amu-occupancy-row">
                                    <span>Adultos</span>
                                    <div class="amu-occupancy-stepper">
                                        <button type="button" data-occupancy-stepper="adults" data-step="-1" aria-label="Quitar un adulto">−</button>
                                        <span data-occupancy-count="adults">2</span>
                                        <button type="button" data-occupancy-stepper="adults" data-step="1" aria-label="Agregar un adulto">+</button>
                                    </div>
                                </div>
                                <div class="amu-occupancy-row">
                                    <span>Niños</span>
                                    <div class="amu-occupancy-stepper">
                                        <button type="button" data-occupancy-stepper="children" data-step="-1" aria-label="Quitar un niño">−</button>
                                        <span data-occupancy-count="children">0</span>
                                        <button type="button" data-occupancy-stepper="children" data-step="1" aria-label="Agregar un niño">+</button>
                                    </div>
                                </div>
                                <div class="amu-occupancy-row">
                                    <span>Habitaciones</span>
                                    <div class="amu-occupancy-stepper">
                                        <button type="button" data-occupancy-stepper="rooms" data-step="-1" aria-label="Quitar una habitación">−</button>
                                        <span data-occupancy-count="rooms">1</span>
                                        <button type="button" data-occupancy-stepper="rooms" data-step="1" aria-label="Agregar una habitación">+</button>
                                    </div>
                                </div>
                                <label class="amu-occupancy-toggle">
                                    <span>¿Viajás por trabajo?</span>
                                    <input type="checkbox" data-occupancy-toggle="work"/>
                                    <span class="amu-switch" aria-hidden="true"/>
                                </label>
                                <label class="amu-occupancy-toggle">
                                    <span>¿Viajás con mascotas?</span>
                                    <input type="checkbox" data-occupancy-toggle="pets"/>
                                    <span class="amu-switch" aria-hidden="true"/>
                                </label>
                                <p class="amu-occupancy-help">
                                    Los animales de asistencia no se consideran mascotas.
                                </p>
                                <button class="amu-occupancy-done" type="button" data-occupancy-done="">
                                    Listo
                                </button>
                            </div>
                        </div>
                        <button class="amu-search-submit" type="submit">
                            <span>Buscar alojamientos</span>
                            <i class="fa fa-arrow-right" aria-hidden="true" />
                        </button>
                    </form>

                    <p class="amu-hero-footnote">
                        Del paisaje que imaginás al lugar que vas a recordar.
                    </p>
                </section>
                <section
                    class="amu-destinations"
                    aria-labelledby="amu-destinations-title"
                >
                    <div class="amu-destinations-heading">
                        <div>
                            <p class="amu-eyebrow">LUGARES PARA DESCUBRIR</p>
                            <h2 id="amu-destinations-title">Destinos</h2>
                        </div>
                        <p>Elegí un paisaje y empezá a imaginar tu próximo viaje.</p>
                    </div>
                    <div class="amu-destination-list">
                        <div class="amu-destination-grid">
                            <a
                                class="amu-destination-card"
                                href="/properties?city=Buenos%20Aires"
                            >
                                <img
                                    src="/pms_website/static/img/ciudad.JPG"
                                    alt="Vista panorámica de la ciudad de Buenos Aires"
                                    loading="lazy"
                                />
                                <span class="amu-destination-details">
                                    <span class="amu-destination-type">CIUDAD</span>
                                    <span class="amu-destination-name">Buenos Aires</span>
                                    <i class="fa fa-arrow-right" aria-hidden="true"/>
                                </span>
                            </a>
                            <a
                                class="amu-destination-card"
                                href="/properties?city=El%20Calafate"
                            >
                                <img
                                    src="/pms_website/static/img/glaciar.jpg"
                                    alt="Glaciar en El Calafate"
                                    loading="lazy"
                                />
                                <span class="amu-destination-details">
                                    <span class="amu-destination-type">PATAGONIA</span>
                                    <span class="amu-destination-name">El Calafate</span>
                                    <i class="fa fa-arrow-right" aria-hidden="true"/>
                                </span>
                            </a>
                            <a
                                class="amu-destination-card"
                                href="/properties?city=Mar%20del%20Plata"
                            >
                                <img
                                    src="/pms_website/static/img/mar.jpg"
                                    alt="Costa y mar en Mar del Plata"
                                    loading="lazy"
                                />
                                <span class="amu-destination-details">
                                    <span class="amu-destination-type">COSTA</span>
                                    <span class="amu-destination-name">Mar del Plata</span>
                                    <i class="fa fa-arrow-right" aria-hidden="true"/>
                                </span>
                            </a>
                            <a
                                class="amu-destination-card"
                                href="/properties?city=Mendoza"
                            >
                                <img
                                    src="/pms_website/static/img/mountain.jpg"
                                    alt="Montañas de los Andes en Mendoza"
                                    loading="lazy"
                                />
                                <span class="amu-destination-details">
                                    <span class="amu-destination-type">MONTAÑA</span>
                                    <span class="amu-destination-name">Mendoza</span>
                                    <i class="fa fa-arrow-right" aria-hidden="true"/>
                                </span>
                            </a>
                        </div>
                    </div>
                </section>
            </main>
        </xpath>
    </template>
</odoo>

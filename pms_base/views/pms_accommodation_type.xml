<odoo>
    <record id="view_pms_accommodation_type_form" model="ir.ui.view">
        <field name="name">pms.accommodation.type.form</field>
        <field name="model">pms.accommodation.type</field>
        <field name="arch" type="xml">
            <form string="Accommodation Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" required="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id" />
                            <field name="capacity" />
                            <field name="bedroom_count" />
                            <field name="bathroom_count" />
                            <field name="area" />
                        </group>
                        <group>
                            <field name="active" />
                            <field name="room_count" />
                            <field name="sequence" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" />
                        </page>
                        <page string="Amenities">
                            <field name="amenity_ids" widget="many2many_tags" />
                        </page>
                        <page string="Physical Rooms">
                            <field name="room_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="capacity" />
                                    <field name="area" />
                                    <field name="floor" />
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pms_accommodation_type_tree" model="ir.ui.view">
        <field name="name">pms.accommodation.type.tree</field>
        <field name="model">pms.accommodation.type</field>
        <field name="arch" type="xml">
            <list string="Accommodation Types">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="property_id" />
                <field name="capacity" />
                <field name="room_count" />
            </list>
        </field>
    </record>

    <record id="view_pms_accommodation_type_search" model="ir.ui.view">
        <field name="name">pms.accommodation.type.search</field>
        <field name="model">pms.accommodation.type</field>
        <field name="arch" type="xml">
            <search string="Accommodation Types">
                <field name="name" />
                <field name="property_id" />
                <filter
                    name="group_by_property"
                    string="Property"
                    context="{'group_by': 'property_id'}"
                />
            </search>
        </field>
    </record>

    <record id="action_pms_accommodation_type" model="ir.actions.act_window">
        <field name="name">Accommodation Types</field>
        <field name="res_model">pms.accommodation.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_property': 1}</field>
    </record>
</odoo>

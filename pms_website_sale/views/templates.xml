<odoo>
    <template
        id="sale_order_portal_content"
        inherit_id="sale.sale_order_portal_content"
        name="Sales Order Portal Content"
    >
        <xpath expr="//td[@name='td_product_name']" position="after">
            <td>
                <t t-if="line.property_id">
                    <t t-esc="line.property_id.name" />
                </t>
            </td>
        </xpath>
        <xpath expr="//th[@id='product_name_header']" position="after">
            <th>Property</th>
        </xpath>
    </template>

    <template id="property_categories_data" name="Category list">
        <li class="nav-item">
            <a
                t-att-href="keep('/property/category/' + slug(c), category=0)"
                t-attf-class="nav-link #{'active' if c.id == category.id else ''}"
            >
                <span t-esc="c.name" />
            </a>
            <ul t-if="c.child_ids" class="nav nav-pills flex-column nav-hierarchy">
                <t t-foreach="c.child_ids" t-as="c">
                    <t t-if="not search or c.id in search_categories_ids">
                        <t t-call="pms_website_sale.property_categories_data" />
                    </t>
                </t>
            </ul>
        </li>
    </template>

    <template
        id="pms_website_sale_search_box"
        inherit_id="website.website_search_box"
        primary="True"
        priority="99"
    >
        <xpath expr="//div[@role='search']" position="attributes">
            <attribute name="t-attf-class" remove="#{_classes}" separator=" " />
        </xpath>
        <xpath expr="//div[@role='search']" position="replace">
            <form
                t-attf-class="o_wsale_products_searchbar_form o_wait_lazy_js #{_classes}"
                t-att-action="action if action else '/property'"
                method="get"
                t-att-data-snippet="_snippet"
            >
                <t>$0</t>
                <!-- <input name="order" class="o_wsale_search_order_by" value=""/> -->
                <t t-out="0" />
            </form>
        </xpath>
    </template>

    <template
        id="pms_search_box"
        inherit_id="pms_website_sale.pms_website_sale_search_box"
        priority="99"
    >
        <xpath expr="//input[@name='search']" position="replace">
            <div class="row g-2 align-items-end w-100">
                <div class="col-12 col-sm-auto flex-sm-grow-1">
                    <label class="form-label small mb-1" for="city">City</label>
                    <select class="form-select" id="city" name="search">
                        <option value="">All cities</option>
                        <t t-foreach="city" t-as="c">
                            <option t-att-value="c" t-att-selected="c == search_city">
                                <t t-esc="c" />
                            </option>
                        </t>
                    </select>
                </div>
                <div class="col-12 col-sm-auto flex-sm-grow-1">
                    <label class="form-label small mb-1" for="date_range">Dates</label>
                    <input
                        class="field_date_range_filtter form-control"
                        id="date_range"
                        name="date_range"
                        type="text"
                        placeholder="Check-in – Check-out"
                        t-att-value="search_raneg"
                    />
                </div>
                <div class="col-12 col-sm-auto">
                    <label
                        class="form-label small mb-1"
                        for="guest_select"
                    >Guests</label>
                    <div class="input-group css_quantity" contenteditable="false">
                        <button
                            type="button"
                            class="btn btn-outline-secondary js_add_cart_json"
                            aria-label="Remove one"
                            title="Remove one"
                        >
                            <i class="fa fa-minus" />
                        </button>
                        <input
                            type="text"
                            class="form-control text-center"
                            style="max-width:60px;"
                            data-min="1"
                            id="guest_select"
                            name="guest_select"
                            placeholder="0"
                            t-att-value="search_guest or ''"
                        />
                        <button
                            type="button"
                            class="btn btn-outline-secondary js_add_cart_json"
                            aria-label="Add one"
                            title="Add one"
                        >
                            <i class="fa fa-plus" />
                        </button>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="search" name="Search Box">
        <t t-call="pms_website_sale.pms_website_sale_search_box">
            <t t-set="action" t-value="'/property'" />
        </t>
    </template>

    <!-- make grid view of template -->
    <template id="property_item" name="Property">
        <t
            t-set="product_href"
            t-value="keep(product.website_url, page=(pager['page']['num'] if pager['page']['num']&gt;1 else None))"
        />

        <form
            action="/shop/cart/update"
            method="post"
            class="card oe_product_cart oe_property_cart"
            t-att-data-publish="product.website_published and 'on' or 'off'"
            itemscope="itemscope"
            itemtype="http://schema.org/Product"
        >
            <div class="card-body p-1 oe_product_image">
                <input
                    type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()"
                />
                <a t-att-href="product_href" class="d-block h-100" itemprop="url">
                    <t t-set="image_holder" t-value="product" />
                    <span
                        t-field="image_holder.image_1920"
                        t-options="{'widget': 'image', 'preview_image': 'image_1024' if product_image_big else 'image_256', 'itemprop': 'image'}"
                        class="d-flex h-100 justify-content-center align-items-center"
                    />
                </a>
            </div>
            <div class="card-body p-0 text-center o_wsale_product_information">
                <div class="p-2 o_wsale_product_information_text">
                    <h6 class="o_wsale_products_item_title">
                        <a
                            itemprop="name"
                            t-att-href="product_href"
                            t-att-content="product.name"
                            t-field="product.name"
                        />
                        <a
                            role="button"
                            t-if="not product.website_published"
                            t-att-href="product_href"
                            class="btn btn-sm btn-danger"
                            title="This product is unpublished."
                        >Unpublished</a>
                    </h6>
                    <!-- <div class="product_price" itemprop="offers" itemscope="itemscope" itemtype="http://schema.org/Offer">
                        <del t-attf-class="text-danger mr-2 {{'' if combination_info['has_discounted_price'] else 'd-none'}}" style="white-space: nowrap;" t-esc="combination_info['list_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}" />
                        <span t-if="combination_info['price']" t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <span itemprop="price" style="display:none;" t-esc="combination_info['price']" />
                        <span itemprop="priceCurrency" style="display:none;" t-esc="website.currency_id.name" />
                    </div> -->
                </div>
                <div class="o_wsale_product_btn" />
            </div>
            <!-- <t t-set="bg_color" t-value="td_product['ribbon']['bg_color'] or ''"/> -->
            <!-- <t t-set="text_color" t-value="td_product['ribbon']['text_color']"/> -->
            <!-- <t t-set="bg_class" t-value="td_product['ribbon']['html_class']"/> -->
            <!-- <span t-attf-class="o_ribbon #{bg_class}" t-attf-style="#{text_color and ('color: %s; ' % text_color)}#{bg_color and 'background-color:' + bg_color}" t-raw="td_product['ribbon']['html'] or ''"/> -->
        </form>
    </template>

    <!-- /property listing -->
    <template id="properties" name="Properties">
        <t t-call="website.layout">
            <t t-set="additional_title">Buscar alojamientos</t>
            <div id="wrap" class="oe_website_sale amu-search-page">
                <section class="amu-results">
                    <form
                        class="amu-search amu-results-search"
                        action="/property"
                        method="get"
                        role="search"
                    >
                        <div class="amu-search-field amu-search-destination">
                            <label for="amu-results-destination">Destino</label>
                            <input
                                id="amu-results-destination"
                                type="search"
                                name="search"
                                placeholder="¿A dónde querés ir?"
                                t-att-value="search_city"
                            />
                        </div>
                        <div class="amu-search-field amu-search-dates">
                            <label for="amu-results-dates">Fechas</label>
                            <div class="amu-date-range">
                                <input
                                    id="amu-results-dates"
                                    type="date"
                                    name="date_start"
                                    aria-label="Fecha de entrada"
                                    t-att-value="search_date_start"
                                />
                                <span class="amu-date-range-separator" aria-hidden="true">—</span>
                                <input
                                    type="date"
                                    name="date_end"
                                    aria-label="Fecha de salida"
                                    t-att-value="search_date_end"
                                />
                            </div>
                        </div>
                        <div class="amu-search-field amu-search-guests">
                            <label>Huéspedes</label>
                            <button
                                id="amu-results-guests"
                                class="amu-occupancy-trigger"
                                type="button"
                                aria-haspopup="dialog"
                                aria-expanded="false"
                                aria-controls="amu-results-occupancy"
                                data-occupancy-trigger=""
                            >
                                <span data-occupancy-summary="" t-out="search_occupancy"/>
                                <i class="fa fa-angle-down" aria-hidden="true"/>
                            </button>
                            <input type="hidden" name="adults" t-att-value="search_adults" data-occupancy-value="adults"/>
                            <input type="hidden" name="children" t-att-value="search_children" data-occupancy-value="children"/>
                            <input type="hidden" name="rooms" t-att-value="search_rooms" data-occupancy-value="rooms"/>
                            <input type="hidden" name="guest_select" t-att-value="search_guest or 2" data-occupancy-total=""/>
                            <input type="hidden" name="work" t-att-value="'1' if search_work else '0'" data-occupancy-toggle-value="work"/>
                            <input type="hidden" name="pets" t-att-value="'1' if search_pets else '0'" data-occupancy-toggle-value="pets"/>
                            <div
                                id="amu-results-occupancy"
                                class="amu-occupancy-popover"
                                role="dialog"
                                aria-label="Huéspedes y habitaciones"
                                hidden="hidden"
                            >
                                <div class="amu-occupancy-row">
                                    <span>Adultos</span>
                                    <div class="amu-occupancy-stepper">
                                        <button type="button" data-occupancy-stepper="adults" data-step="-1" aria-label="Quitar un adulto">−</button>
                                        <span data-occupancy-count="adults" t-out="search_adults"/>
                                        <button type="button" data-occupancy-stepper="adults" data-step="1" aria-label="Agregar un adulto">+</button>
                                    </div>
                                </div>
                                <div class="amu-occupancy-row">
                                    <span>Niños</span>
                                    <div class="amu-occupancy-stepper">
                                        <button type="button" data-occupancy-stepper="children" data-step="-1" aria-label="Quitar un niño">−</button>
                                        <span data-occupancy-count="children" t-out="search_children"/>
                                        <button type="button" data-occupancy-stepper="children" data-step="1" aria-label="Agregar un niño">+</button>
                                    </div>
                                </div>
                                <div class="amu-occupancy-row">
                                    <span>Habitaciones</span>
                                    <div class="amu-occupancy-stepper">
                                        <button type="button" data-occupancy-stepper="rooms" data-step="-1" aria-label="Quitar una habitación">−</button>
                                        <span data-occupancy-count="rooms" t-out="search_rooms"/>
                                        <button type="button" data-occupancy-stepper="rooms" data-step="1" aria-label="Agregar una habitación">+</button>
                                    </div>
                                </div>
                                <label class="amu-occupancy-toggle">
                                    <span>¿Viajás por trabajo?</span>
                                    <input type="checkbox" data-occupancy-toggle="work" t-att-checked="search_work"/>
                                    <span class="amu-switch" aria-hidden="true"/>
                                </label>
                                <label class="amu-occupancy-toggle">
                                    <span>¿Viajás con mascotas?</span>
                                    <input type="checkbox" data-occupancy-toggle="pets" t-att-checked="search_pets"/>
                                    <span class="amu-switch" aria-hidden="true"/>
                                </label>
                                <p class="amu-occupancy-help">
                                    Los animales de asistencia no se consideran mascotas.
                                </p>
                                <button class="amu-occupancy-done" type="button" data-occupancy-done="">
                                    Listo
                                </button>
                            </div>
                        </div>
                        <input
                            type="hidden"
                            name="property_type"
                            t-att-value="selected_property_type"
                        />
                        <input
                            t-if="category"
                            type="hidden"
                            name="category"
                            t-att-value="category.id"
                        />
                        <input
                            t-foreach="selected_amenity_ids"
                            t-as="selected_amenity_id"
                            type="hidden"
                            name="amenity_ids"
                            t-att-value="selected_amenity_id"
                        />
                        <button class="amu-search-submit" type="submit">
                            <span>Actualizar búsqueda</span>
                            <i class="fa fa-arrow-right" aria-hidden="true" />
                        </button>
                    </form>

                    <div class="amu-results-heading">
                        <div>
                            <p class="amu-eyebrow">ENCONTRÁ TU PRÓXIMA ESTADÍA</p>
                            <h1>
                                <t t-if="search_city">Alojamientos en <t t-out="search_city" /></t>
                                <t t-else="">Explorá nuestros alojamientos</t>
                            </h1>
                            <p class="amu-results-count">
                                <t t-out="search_count" /> alojamientos disponibles
                            </p>
                        </div>
                        <a class="amu-results-reset" href="/property">Limpiar búsqueda</a>
                    </div>

                    <div class="amu-results-layout">
                        <aside class="amu-filter-sidebar">
                            <form action="/property" method="get" class="amu-filter-form">
                                <input
                                    type="hidden"
                                    name="search"
                                    t-att-value="search_city"
                                />
                                <input
                                    type="hidden"
                                    name="date_start"
                                    t-att-value="search_date_start"
                                />
                                <input type="hidden" name="date_end" t-att-value="search_date_end"/>
                                <input
                                    type="hidden"
                                    name="guest_select"
                                    t-att-value="search_guest or 2"
                                />
                                <input type="hidden" name="adults" t-att-value="search_adults"/>
                                <input type="hidden" name="children" t-att-value="search_children"/>
                                <input type="hidden" name="rooms" t-att-value="search_rooms"/>
                                <input t-if="search_work" type="hidden" name="work" value="1"/>
                                <input t-if="search_pets" type="hidden" name="pets" value="1"/>
                                <input
                                    t-if="category"
                                    type="hidden"
                                    name="category"
                                    t-att-value="category.id"
                                />
                                <h2>Filtros</h2>
                                <fieldset class="amu-filter-group">
                                    <legend>Tipo de alojamiento</legend>
                                    <label class="amu-filter-option">
                                        <input
                                            type="radio"
                                            name="property_type"
                                            value=""
                                            t-att-checked="not selected_property_type"
                                        />
                                        <span>Todos</span>
                                    </label>
                                    <label
                                        t-foreach="property_types"
                                        t-as="property_type_option"
                                        class="amu-filter-option"
                                    >
                                        <input
                                            type="radio"
                                            name="property_type"
                                            t-att-value="property_type_option[0]"
                                            t-att-checked="selected_property_type == property_type_option[0]"
                                        />
                                        <span t-out="property_type_option[1]" />
                                    </label>
                                </fieldset>
                                <div class="amu-amenity-filters">
                                    <h3>Características y amenidades</h3>
                                    <fieldset
                                        t-foreach="amenity_filter_groups"
                                        t-as="amenity_group"
                                        class="amu-filter-group"
                                    >
                                        <legend t-out="amenity_group['name']" />
                                        <label
                                            t-foreach="amenity_group['amenities']"
                                            t-as="amenity_option"
                                            class="amu-filter-option"
                                        >
                                            <input
                                                type="checkbox"
                                                name="amenity_ids"
                                                t-att-value="amenity_option.id"
                                                t-att-checked="amenity_option.id in selected_amenity_ids"
                                            />
                                            <span t-out="amenity_option.name" />
                                        </label>
                                    </fieldset>
                                </div>
                                <button class="amu-filter-submit" type="submit">
                                    Aplicar filtros
                                </button>
                                <a class="amu-filter-reset" href="/property">
                                    Quitar filtros
                                </a>
                            </form>
                            <div id="products_grid_before" />
                        </aside>

                        <div class="amu-results-list">
                            <div class="amu-results-toolbar">
                                <span class="amu-results-toolbar-label">Ver como</span>
                                <div
                                    class="amu-view-switch"
                                    role="group"
                                    aria-label="Presentación de alojamientos"
                                >
                                    <button
                                        type="button"
                                        class="amu-view-button"
                                        data-results-view="list"
                                        aria-pressed="true"
                                    >
                                        <i class="fa fa-list" aria-hidden="true" />
                                        <span>Lista</span>
                                    </button>
                                    <button
                                        type="button"
                                        class="amu-view-button"
                                        data-results-view="grid"
                                        aria-pressed="false"
                                    >
                                        <i class="fa fa-th-large" aria-hidden="true" />
                                        <span>Cuadrícula</span>
                                    </button>
                                </div>
                            </div>
                            <div class="amu-property-grid" data-results-grid="">
                                <article
                                    t-foreach="properties"
                                    t-as="property"
                                    class="amu-property-card"
                                >
                                    <a
                                        class="amu-property-image"
                                        t-att-href="property.website_url"
                                        t-att-aria-label="property.name"
                                    >
                                        <span
                                            t-field="property.image_1920"
                                            t-options="{'widget': 'image', 'preview_image': 'image_1024', 'class': 'w-100 h-100', 'alt-field': 'name'}"
                                        />
                                        <span
                                            class="amu-property-type"
                                            t-out="'Hotel' if property.property_type == 'hotel' else 'Casa o apartamento'"
                                        />
                                    </a>
                                    <div class="amu-property-info">
                                        <div class="amu-property-title-row">
                                            <div>
                                                <p class="amu-property-location">
                                                    <i class="fa fa-map-marker" aria-hidden="true" />
                                                    <span t-out="property.city or 'Argentina'" />
                                                </p>
                                                <h2>
                                                    <a t-att-href="property.website_url" t-out="property.name" />
                                                </h2>
                                            </div>
                                            <span
                                                t-if="property.no_of_guests"
                                                class="amu-property-guests"
                                            >
                                                <i class="fa fa-user-o" aria-hidden="true" />
                                                Hasta <t t-out="property.no_of_guests" /> huéspedes
                                            </span>
                                        </div>
                                        <div
                                            t-if="property.website_description1"
                                            class="amu-property-description"
                                            t-field="property.website_description1"
                                        />
                                        <p t-else="" class="amu-property-description">
                                            <t t-if="property.property_type == 'hotel'">
                                                Habitaciones preparadas para disfrutar tu estadía.
                                            </t>
                                            <t t-else="">
                                                Un espacio para vivir el destino a tu manera.
                                            </t>
                                        </p>
                                        <t
                                            t-set="card_amenities"
                                            t-value="property.amenity_ids.filtered(lambda amenity: amenity.is_main_amenity)[:4]"
                                        />
                                        <div
                                            t-if="card_amenities"
                                            class="amu-property-amenities"
                                        >
                                            <span
                                                t-foreach="card_amenities"
                                                t-as="amenity"
                                                class="amu-property-amenity"
                                                t-out="amenity.name"
                                            />
                                        </div>
                                        <div class="amu-property-meta">
                                            <span t-if="property.qty_bedroom">
                                                <i class="fa fa-bed" aria-hidden="true" />
                                                <t t-out="property.qty_bedroom" /> dormitorios
                                            </span>
                                            <span t-if="property.bathroom_count">
                                                <i class="fa fa-bath" aria-hidden="true" />
                                                <t t-out="property.bathroom_count" /> baños
                                            </span>
                                            <span t-if="property.area">
                                                <i class="fa fa-arrows-alt" aria-hidden="true" />
                                                <t t-out="property.area" /> m²
                                            </span>
                                        </div>
                                        <a class="amu-property-link" t-att-href="property.website_url">
                                            Ver alojamiento
                                            <i class="fa fa-arrow-right" aria-hidden="true" />
                                        </a>
                                    </div>
                                </article>
                                <div t-if="not properties" class="amu-empty-results">
                                    <span class="amu-empty-mark" aria-hidden="true">✳</span>
                                    <h2>No encontramos alojamientos con esos criterios</h2>
                                    <p>Probá con otro destino o quitá alguno de los filtros.</p>
                                    <a href="/property" class="amu-filter-submit">Ver todos los alojamientos</a>
                                </div>
                            </div>
                            <div class="amu-results-pager" t-if="pager">
                                <t t-call="website.pager" />
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template
        id="property_booking_form"
        inherit_id="pms_website.property"
        name="Property Booking Form"
    >
        <!-- Book Now button in property details -->
        <xpath expr="//div[@id='product_details']" position="inside">
            <div class="mt-3">
                <t t-if="is_public_user">
                    <a
                        t-attf-href="/web/login?redirect=#{property.website_url}"
                        class="btn btn-primary btn-lg"
                    >
                        <i class="fa fa-sign-in" />
                        Log in to Book
                    </a>
                </t>
                <t t-elif="reservation_types">
                    <button
                        type="button"
                        class="btn btn-primary btn-lg"
                        data-bs-toggle="modal"
                        data-bs-target="#pmsBookingModal"
                    >
                        <i class="fa fa-calendar" />
                        Book Now
                    </button>
                </t>
            </div>
        </xpath>

        <!-- Booking modal -->
        <xpath
            expr="//div[hasclass('modal','fade','right') and @id='exampleModalPreview']"
            position="before"
        >
            <t t-if="not is_public_user and reservation_types">
                <div
                    class="modal fade"
                    id="pmsBookingModal"
                    tabindex="-1"
                    aria-labelledby="pmsBookingModalLabel"
                    aria-hidden="true"
                    t-att-data-property-id="property.id"
                >
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="pmsBookingModalLabel">
                                    Book <span t-field="property.name" />
                                </h5>
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                />
                            </div>
                            <div class="modal-body">
                                <form id="pmsBookingForm">
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label
                                                for="date_start"
                                                class="form-label"
                                            >Check-in</label>
                                            <input
                                                type="date"
                                                class="form-control"
                                                id="date_start"
                                                name="date_start"
                                                required="required"
                                            />
                                        </div>
                                        <div class="col-md-4">
                                            <label
                                                for="date_end"
                                                class="form-label"
                                            >Check-out</label>
                                            <input
                                                type="date"
                                                class="form-control"
                                                id="date_end"
                                                name="date_end"
                                                required="required"
                                            />
                                        </div>
                                        <div class="col-md-4">
                                            <label
                                                class="form-label"
                                            >Availability</label>
                                            <div
                                                id="pms_availability_status"
                                                class="mt-2 text-muted small"
                                            >Select dates to check</div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label
                                            for="reservation_type_id"
                                            class="form-label"
                                        >Reservation Type</label>
                                        <select
                                            class="form-select"
                                            id="reservation_type_id"
                                            name="reservation_type_id"
                                            required="required"
                                        >
                                            <option value="">-- Select --</option>
                                            <t t-foreach="reservation_types" t-as="rt">
                                                <option
                                                    t-att-value="rt['offer'].id"
                                                    t-att-data-accommodation-type-id="rt['accommodation_type'].id or ''"
                                                    t-att-data-max-guests="rt['accommodation_type'].capacity or property.no_of_guests or 0"
                                                >
                                                    <t
                                                        t-if="rt['accommodation_type']"
                                                        t-esc="rt['accommodation_type'].name + ' - '"
                                                    />
                                                    <t t-esc="rt['offer'].name" />
                                                    <t t-if="rt['is_fallback']">
                                                        (tarifa general)
                                                    </t>
                                                    <t t-if="rt['offer'].price">
                                                        (<t
                                                        t-esc="rt['offer'].price"
                                                        t-options='{"widget": "float", "precision": 2}'
                                                    />&#160;<t
                                                        t-esc="rt['offer'].currency_id.symbol"
                                                    />)
                                                    </t>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">
                                            Guests
                                            <t t-if="property.no_of_guests">
                                            <span class="text-muted small">(max
                                                    <t
                                                t-esc="property.no_of_guests"
                                            />)</span>
                                        </t>
                                        </label>
                                        <div id="pms_guest_list">
                                            <div
                                                class="pms-guest-row row mb-2 align-items-center"
                                            >
                                                <div class="col-md-4">
                                                    <input
                                                        type="text"
                                                        class="form-control"
                                                        name="guest_name_0"
                                                        data-guest-field="name"
                                                        placeholder="Full Name"
                                                        required="required"
                                                    />
                                                </div>
                                                <div class="col-md-3">
                                                    <input
                                                        type="tel"
                                                        class="form-control"
                                                        name="guest_phone_0"
                                                        data-guest-field="phone"
                                                        placeholder="Phone"
                                                    />
                                                </div>
                                                <div class="col-md-4">
                                                    <input
                                                        type="email"
                                                        class="form-control"
                                                        name="guest_email_0"
                                                        data-guest-field="email"
                                                        placeholder="Email"
                                                    />
                                                </div>
                                            </div>
                                        </div>
                                        <button
                                            type="button"
                                            class="btn btn-outline-secondary btn-sm mt-2"
                                            id="pms_add_guest"
                                            t-att-data-max="property.no_of_guests or 0"
                                            t-att-data-property-max="property.no_of_guests or 0"
                                        >
                                            <i class="fa fa-plus" />
                                            Add Guest
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button
                                    type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal"
                                >Cancel</button>
                                <button
                                    type="button"
                                    id="pmsAddToCart"
                                    class="btn btn-primary"
                                >
                                    <i class="fa fa-shopping-cart" />
                                    Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template
        id="property_categories"
        inherit_id="pms_website_sale.properties"
        active="True"
        customize_show="True"
        name="Property Categories"
    >
        <xpath expr="//div[@id='products_grid_before']" position="before">
            <t t-set="enable_left_column" t-value="True" />
        </xpath>
        <xpath expr="//div[@id='products_grid_before']" position="inside">
            <button
                type="button"
                class="btn btn-link d-lg-none"
                data-bs-target="#wsale_products_categories_collapse"
                data-bs-toggle="collapse"
            >
                Show categories
            </button>
            <div class="collapse d-lg-block" id="wsale_products_categories_collapse">
                <ul class="nav nav-pills flex-column mb-2">
                    <li class="nav-item">
                        <a
                            t-att-href="keep('/property',category=0)"
                            t-attf-class="nav-link #{'' if category else 'active'} o_not_editable"
                        >All Properties</a>
                    </li>
                    <t t-foreach="categories" t-as="c">
                        <t t-call="pms_website_sale.property_categories_data" />
                    </t>
                </ul>
            </div>
        </xpath>
    </template>
</odoo>

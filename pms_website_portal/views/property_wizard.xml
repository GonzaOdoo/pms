<odoo>
    <template id="page_property_wizard_type" name="Asistente: tipo de alojamiento">
        <t t-call="pms_website_portal.layout">
            <t t-set="ts_actions">
                <a href="/my/properties" class="ts-btn ts-btn-ghost">Volver</a>
            </t>
            <section class="ts-card ts-wizard">
                <h2>1. ¿Qué tipo de alojamiento vas a ofrecer?</h2>
                <p class="ts-muted">
                    Lo configuraremos como una propiedad completa o como un hotel
                    con habitaciones reservables.
                </p>
                <form
                    class="ts-form"
                    method="post"
                    action="/my/properties/wizard/start"
                >
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />
                    <label class="ts-wide">
                        Nombre del alojamiento
                        <input name="name" required="required" maxlength="120" />
                    </label>
                    <fieldset class="ts-wide ts-type-options">
                        <legend>Tipo de propiedad</legend>
                        <label class="ts-type-card">
                            <input
                                type="radio"
                                name="property_type"
                                value="house"
                                required="required"
                            />
                            <span>
                                <strong>Casa o apartamento</strong>
                                <small>Los huéspedes reservan toda la propiedad.</small>
                            </span>
                        </label>
                        <label class="ts-type-card">
                            <input
                                type="radio"
                                name="property_type"
                                value="hotel"
                                required="required"
                            />
                            <span>
                                <strong>Hotel</strong>
                                <small>Los huéspedes reservan por tipo de habitación.</small>
                            </span>
                        </label>
                        <label class="ts-type-card">
                            <input
                                type="radio"
                                name="property_type"
                                value="camping"
                                required="required"
                            />
                            <span>
                                <strong>Camping</strong>
                                <small>Los huéspedes reservan toda la propiedad.</small>
                            </span>
                        </label>
                    </fieldset>
                    <div class="ts-wide ts-form-actions">
                        <button type="submit" class="ts-btn">Comenzar</button>
                    </div>
                </form>
            </section>
        </t>
    </template>

    <template id="page_property_wizard_step" name="Asistente: configurar alojamiento">
        <t t-call="pms_website_portal.layout">
            <t t-set="ts_actions">
                <a href="/my/properties" class="ts-btn ts-btn-ghost">Guardar y salir</a>
            </t>
            <section class="ts-card ts-wizard">
                <p class="ts-wizard-property">
                    <strong t-out="prop.name" />
                    <span
                        class="ts-pill"
                        t-out="'Hotel' if prop.property_type == 'hotel' else ('Camping' if prop.property_type == 'camping' else 'Casa o apartamento')"
                    />
                </p>
                <nav class="ts-wizard-steps" aria-label="Pasos de configuración">
                    <t t-foreach="wizard_steps" t-as="wizard_item">
                        <a
                            t-if="not wizard_item['disabled']"
                            t-att-href="wizard_item['url']"
                            t-att-class="'is-active' if wizard_item['active'] else ('is-complete' if wizard_item['complete'] else '')"
                        >
                            <span t-out="wizard_item_index + 1" />
                            <span t-out="wizard_item['label']" />
                        </a>
                        <span
                            t-else=""
                            class="is-disabled"
                            aria-disabled="true"
                        >
                            <span t-out="wizard_item_index + 1" />
                            <span t-out="wizard_item['label']" />
                        </span>
                    </t>
                </nav>

                <t t-if="wizard_step == 'address'">
                    <h2>Dirección del alojamiento</h2>
                    <p class="ts-muted">Indica dónde podrán encontrarlo tus huéspedes.</p>
                    <form
                        class="ts-form"
                        method="post"
                        t-attf-action="/my/properties/#{prop.id}/wizard/address/save"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <label class="ts-wide">
                            Calle y número
                            <input name="street" required="required" t-att-value="prop.street" />
                        </label>
                        <label class="ts-wide">
                            Piso, departamento u otra referencia
                            <input name="street2" t-att-value="prop.street2" />
                        </label>
                        <label>
                            Ciudad
                            <input name="city" required="required" t-att-value="prop.city" />
                        </label>
                        <label>
                            Código postal
                            <input name="zip" t-att-value="prop.zip" />
                        </label>
                        <div class="ts-wide ts-form-actions">
                            <button type="submit" class="ts-btn">Continuar</button>
                        </div>
                    </form>
                </t>

                <t t-if="wizard_step == 'photos'">
                    <h2>Fotos de la propiedad</h2>
                    <p class="ts-muted">
                        Agrega imágenes JPG, PNG o WebP. Puedes cargar hasta 10 por vez,
                        con un máximo de 20 fotos por propiedad. Este paso es opcional.
                    </p>
                    <p class="ts-muted">
                        Fotos cargadas: <t t-out="len(prop.image_ids)" /> de 20.
                    </p>
                    <form
                        class="ts-form"
                        method="post"
                        enctype="multipart/form-data"
                        t-attf-action="/my/properties/#{prop.id}/wizard/photos/save"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <label class="ts-wide">
                            Seleccionar fotos
                            <input
                                type="file"
                                name="images"
                                accept="image/jpeg,image/png,image/webp"
                                multiple="multiple"
                                t-att-disabled="len(prop.image_ids) >= 20"
                            />
                        </label>
                        <div class="ts-wide ts-form-actions">
                            <button type="submit" class="ts-btn">Guardar y continuar</button>
                        </div>
                    </form>
                    <div t-if="prop.image_ids" class="ts-property-images">
                        <article
                            t-foreach="prop.image_ids"
                            t-as="property_image"
                            class="ts-property-image"
                        >
                            <img
                                t-att-src="'/web/image/pms.property.image/%s/image_1920' % property_image.id"
                                t-att-alt="property_image.name"
                            />
                            <span t-out="property_image.name" />
                            <form
                                method="post"
                                t-attf-action="/my/properties/#{prop.id}/images/#{property_image.id}/delete"
                            >
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    t-att-value="request.csrf_token()"
                                />
                                <button type="submit" class="ts-btn ts-btn-ghost">
                                    Quitar
                                </button>
                            </form>
                        </article>
                    </div>
                </t>

                <t t-if="wizard_step == 'amenities'">
                    <h2>Características y servicios</h2>
                    <p class="ts-muted">
                        Completa los datos generales y selecciona los servicios disponibles
                        en toda la propiedad.
                    </p>
                    <form
                        class="ts-form"
                        method="post"
                        t-attf-action="/my/properties/#{prop.id}/wizard/amenities/save"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <label>
                            Superficie total (m²)
                            <input
                                type="number"
                                name="area"
                                min="0"
                                step="0.01"
                                t-att-value="prop.area"
                            />
                        </label>
                        <label>
                            Capacidad máxima (huéspedes)
                            <input
                                type="number"
                                name="no_of_guests"
                                min="1"
                                required="required"
                                t-att-value="prop.no_of_guests"
                            />
                        </label>
                        <label>
                            Estadía mínima (noches)
                            <input
                                type="number"
                                name="min_nights"
                                min="0"
                                t-att-value="prop.min_nights"
                            />
                        </label>
                        <label>
                            Estadía máxima (noches)
                            <input
                                type="number"
                                name="max_nights"
                                min="1"
                                t-att-value="prop.max_nights or 30"
                            />
                        </label>
                        <fieldset class="ts-wide ts-amenities">
                            <legend>Servicios de la propiedad</legend>
                            <label t-foreach="amenities" t-as="amenity">
                                <input
                                    type="checkbox"
                                    name="amenity_ids"
                                    t-att-value="amenity.id"
                                    t-att-checked="amenity in prop.amenity_ids"
                                />
                                <span t-out="amenity.name" />
                            </label>
                            <p t-if="not amenities" class="ts-muted">
                                No hay servicios configurados para seleccionar.
                            </p>
                        </fieldset>
                        <div class="ts-wide ts-form-actions">
                            <button type="submit" class="ts-btn">Continuar</button>
                        </div>
                    </form>
                </t>

                <t t-if="wizard_step == 'inventory' and prop.property_type in ('house', 'camping')">
                    <h2>Detalles de la casa o apartamento</h2>
                    <p class="ts-muted">
                        Esta opción se ofrecerá como una sola propiedad; no se reservará
                        por habitación.
                    </p>
                    <form
                        class="ts-form"
                        method="post"
                        t-attf-action="/my/properties/#{prop.id}/wizard/inventory/save"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <label>
                            Dormitorios
                            <input
                                type="number"
                                name="bedroom_count"
                                min="0"
                                t-att-value="prop.bedroom_count"
                            />
                        </label>
                        <label>
                            Baños
                            <input
                                type="number"
                                name="bathroom_count"
                                min="0"
                                t-att-value="prop.bathroom_count"
                            />
                        </label>
                        <div class="ts-wide ts-form-actions">
                            <button type="submit" class="ts-btn">Continuar</button>
                        </div>
                    </form>
                </t>

                <t t-if="wizard_step == 'inventory' and prop.property_type == 'hotel'">
                    <h2>Tipo de habitación</h2>
                    <p class="ts-muted">
                        Define las características de esta categoría. Después podrás
                        agregar las habitaciones físicas que pertenecen a ella.
                    </p>
                    <form
                        class="ts-form"
                        method="post"
                        t-attf-action="/my/properties/#{prop.id}/wizard/inventory/save"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <label class="ts-wide">
                            Nombre del tipo
                            <input
                                name="accommodation_name"
                                required="required"
                                t-att-value="accommodation_type.name if accommodation_type else 'Habitación estándar'"
                            />
                        </label>
                        <label>
                            Capacidad por habitación
                            <input
                                type="number"
                                name="capacity"
                                min="1"
                                required="required"
                                t-att-value="accommodation_type.capacity if accommodation_type else 2"
                            />
                        </label>
                        <label>
                            Dormitorios por habitación
                            <input
                                type="number"
                                name="bedroom_count"
                                min="0"
                                t-att-value="accommodation_type.bedroom_count if accommodation_type else 1"
                            />
                        </label>
                        <label>
                            Baños por habitación
                            <input
                                type="number"
                                name="bathroom_count"
                                min="0"
                                t-att-value="accommodation_type.bathroom_count if accommodation_type else 1"
                            />
                        </label>
                        <label>
                            Superficie por habitación (m²)
                            <input
                                type="number"
                                name="area"
                                min="0"
                                step="0.01"
                                t-att-value="accommodation_type.area if accommodation_type else ''"
                            />
                        </label>
                        <fieldset class="ts-wide ts-amenities">
                            <legend>Servicios de las habitaciones</legend>
                            <label t-foreach="room_amenities" t-as="amenity">
                                <input
                                    type="checkbox"
                                    name="room_amenity_ids"
                                    t-att-value="amenity.id"
                                    t-att-checked="accommodation_type and amenity in accommodation_type.amenity_ids"
                                />
                                <span t-out="amenity.name" />
                            </label>
                        </fieldset>
                        <div class="ts-wide ts-form-actions">
                            <button type="submit" class="ts-btn">Continuar</button>
                        </div>
                    </form>
                    <div class="ts-wizard-note" t-if="accommodation_types">
                        <strong>Tipos configurados:</strong>
                        <ul>
                            <li t-foreach="accommodation_types" t-as="item">
                                <span t-out="item.name"/> —
                                <span t-out="item.room_count"/> habitaciones
                            </li>
                        </ul>
                    </div>
                    <a
                        t-if="accommodation_type"
                        t-attf-href="/my/rooms/new?property_id=#{prop.id}"
                        class="ts-btn ts-btn-ghost"
                    >Agregar habitaciones</a>
                    <a
                        t-if="accommodation_type"
                        t-attf-href="/my/accommodation-types/new?property_id=#{prop.id}"
                        class="ts-btn ts-btn-ghost"
                    >Agregar otro tipo de alojamiento</a>
                </t>

                <t t-if="wizard_step == 'rate'">
                    <h2>Tarifa de reserva</h2>
                    <p t-if="prop.property_type == 'hotel'" class="ts-muted">
                        La tarifa propia de este tipo de habitación es opcional. Si
                        queda vacía, se utilizará una tarifa general disponible.
                    </p>
                    <p t-else="" class="ts-muted">
                        Define el precio por noche de la propiedad.
                    </p>
                    <div t-if="prop.property_type == 'hotel'" class="ts-action-row ts-wide">
                        <a
                            t-attf-href="/my/rooms/new?property_id=#{prop.id}"
                            class="ts-btn ts-btn-ghost"
                        >Agregar habitaciones</a>
                        <a
                            t-attf-href="/my/accommodation-types/new?property_id=#{prop.id}"
                            class="ts-btn ts-btn-ghost"
                        >Agregar otro tipo de alojamiento</a>
                    </div>
                    <form
                        class="ts-form"
                        method="post"
                        t-attf-action="/my/properties/#{prop.id}/wizard/rate/save"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <label class="ts-wide">
                            Nombre de la tarifa
                            <input
                                name="reservation_name"
                                t-att-required="prop.property_type != 'hotel'"
                                t-att-value="reservation_offer.name if reservation_offer else 'Tarifa estándar'"
                            />
                        </label>
                        <label>
                            Precio por noche
                            <input
                                type="number"
                                name="price"
                                min="0"
                                step="0.01"
                                t-att-required="prop.property_type != 'hotel'"
                                t-att-value="reservation_offer.price if reservation_offer else ''"
                            />
                        </label>
                        <p class="ts-wide ts-muted">
                            Si no defines una tarifa para este tipo de habitación,
                            se utilizará una tarifa general disponible.
                        </p>
                        <div class="ts-wide ts-form-actions">
                            <button type="submit" class="ts-btn">Continuar</button>
                        </div>
                    </form>
                </t>

                <t t-if="wizard_step == 'review'">
                    <h2>Revisa tu propiedad</h2>
                    <dl class="ts-dl">
                        <div><dt>Tipo</dt><dd t-out="'Hotel' if prop.property_type == 'hotel' else ('Camping' if prop.property_type == 'camping' else 'Casa o apartamento')"/></div>
                        <div><dt>Dirección</dt><dd><span t-out="prop.street"/>, <span t-out="prop.city"/></dd></div>
                        <div><dt>Fotos</dt><dd t-out="len(prop.image_ids)"/></div>
                        <div><dt>Capacidad</dt><dd><span t-out="prop.no_of_guests"/> huéspedes</dd></div>
                        <div t-if="prop.property_type in ('house', 'camping')"><dt>Dormitorios</dt><dd t-out="prop.bedroom_count"/></div>
                        <div t-if="prop.property_type in ('house', 'camping')"><dt>Baños</dt><dd t-out="prop.bathroom_count"/></div>
                        <div
                            t-if="prop.property_type == 'hotel'"
                            t-foreach="accommodation_types"
                            t-as="item"
                        >
                            <dt t-out="item.name"/>
                            <dd>
                                <span t-out="len(item.room_ids.filtered('active'))"/>
                                habitaciones ·
                                <span t-out="item.capacity"/> personas ·
                                <span t-out="item.bedroom_count"/> dormitorios ·
                                <span t-out="item.bathroom_count"/> baños
                            </dd>
                        </div>
                        <div t-if="reservation_offer"><dt>Tarifa por noche</dt><dd><span t-out="reservation_offer.price"/> <span t-out="reservation_offer.currency_id.symbol"/></dd></div>
                    </dl>
                    <div class="ts-wizard-note">
                        Al terminar, la propiedad quedará lista para que la administración
                        la publique. No aparecerá en el sitio público antes de ser publicada.
                    </div>
                    <form
                        class="ts-form-actions"
                        method="post"
                        t-attf-action="/my/properties/#{prop.id}/wizard/complete"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <button type="submit" class="ts-btn">Finalizar configuración</button>
                    </form>
                </t>
            </section>
        </t>
    </template>
</odoo>

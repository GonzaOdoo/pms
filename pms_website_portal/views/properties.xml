<odoo>
    <template id="page_properties" name="Panel: propiedades">
        <t t-call="pms_website_portal.layout">
            <t t-set="ts_actions"><a href="/my/properties/new" class="ts-btn">Nueva propiedad</a></t>
            <form class="ts-search" method="get" action="/my/properties">
                <input type="search" name="q" t-att-value="q" placeholder="Buscar por nombre"/>
                <button type="submit" class="ts-btn ts-btn-ghost">Buscar</button>
            </form>
            <section class="ts-card">
                <p t-if="not properties" class="ts-empty">No hay propiedades. Creá la primera con “Nueva propiedad”.</p>
                <div t-else="" class="ts-table-wrap">
                    <table class="ts-table">
                        <thead><tr><th>Nombre</th><th>Ciudad</th><th>Superficie</th><th>Habitaciones</th><th>Configuración</th><th>Acciones</th></tr></thead>
                        <tbody>
                            <tr t-foreach="properties" t-as="p">
                                <td><a t-attf-href="/my/properties/#{p.id}" t-out="p.name"/></td>
                                <td t-out="p.city or '—'"/>
                                <td><t t-if="p.area"><t t-out="p.area"/> m²</t><t t-else="">—</t></td>
                                <td t-out="p.bedroom_count if p.property_type == 'house' else p.room_count"/>
                                <td>
                                    <span
                                        t-if="p.setup_state == 'draft'"
                                        class="ts-pill ts-pill-warning"
                                    >Borrador</span>
                                    <span t-else="" class="ts-pill ts-pill-ready">Lista</span>
                                </td>
                                <td class="ts-right">
                                    <a
                                        t-if="p.setup_state == 'draft'"
                                        t-attf-href="/my/properties/#{p.id}/wizard/#{p.setup_step or 'address'}"
                                    >Continuar configuración</a>
                                    <a t-else="" t-attf-href="/my/rooms?property_id=#{p.id}">Ver habitaciones</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </t>
    </template>

    <template id="page_property_form" name="Panel: ficha de propiedad">
        <t t-call="pms_website_portal.layout">
            <t t-set="ts_actions"><a href="/my/properties" class="ts-btn ts-btn-ghost">Volver</a></t>
            <form class="ts-card ts-form" method="post" enctype="multipart/form-data" action="/my/properties/save">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="property_id" t-att-value="prop.id if prop else 0"/>
                <label class="ts-wide">Nombre<input name="name" required="required" t-att-value="prop.name if prop else ''"/></label>
                <label class="ts-wide">Dirección<input name="street" t-att-value="prop.street if prop else ''"/></label>
                <label>Ciudad<input name="city" t-att-value="prop.city if prop else ''"/></label>
                <label>Código postal<input name="zip" t-att-value="prop.zip if prop else ''"/></label>
                <label>Superficie (m²)<input name="area" inputmode="decimal" t-att-value="prop.area if prop else ''"/></label>
                <label>Capacidad (huéspedes)<input name="no_of_guests" type="number" min="0" t-att-value="prop.no_of_guests if prop else ''"/></label>
                <label>Mínimo de noches<input name="min_nights" type="number" min="0" t-att-value="prop.min_nights if prop else 1"/></label>
                <label>Máximo de noches<input name="max_nights" type="number" min="1" t-att-value="prop.max_nights if prop else 30"/></label>
                <label class="ts-wide">
                    Fotos de la propiedad
                    <span class="ts-muted">
                        <t t-out="len(prop.image_ids)" /> de 20 fotos cargadas. JPG, PNG o WebP;
                        hasta 10 fotos por carga.
                    </span>
                    <input
                        type="file"
                        name="images"
                        accept="image/jpeg,image/png,image/webp"
                        multiple="multiple"
                        t-att-disabled="len(prop.image_ids) >= 20"
                    />
                </label>
                <div class="ts-wide ts-form-actions"><button type="submit" class="ts-btn">Guardar cambios y fotos</button></div>
            </form>
            <div t-if="prop.image_ids" class="ts-property-images">
                <article
                    t-foreach="prop.image_ids"
                    t-as="property_image"
                    class="ts-property-image"
                >
                    <img
                        t-att-src="'/web/image/pms.property.image/%s/image_1920' % property_image.id"
                        t-att-alt="property_image.name"
                    />
                    <span t-out="property_image.name" />
                    <form
                        method="post"
                        t-attf-action="/my/properties/#{prop.id}/images/#{property_image.id}/delete"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <button type="submit" class="ts-btn ts-btn-ghost">
                            Quitar
                        </button>
                    </form>
                </article>
            </div>
        </t>
    </template>
</odoo>
